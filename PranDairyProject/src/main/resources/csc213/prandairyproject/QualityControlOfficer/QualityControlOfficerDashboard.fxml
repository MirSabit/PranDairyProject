<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="TOP_CENTER" spacing="25.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="QualityControlOfficer.QualityControlOfficerDashboard">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Quality Control Officer Dashboard">
         <font>
            <Font size="26.0" />
         </font>
      </Text>
      <GridPane alignment="CENTER" hgap="15.0" vgap="15.0">
         <children>
            <Button fx:id="inspectrawmilkButton" onAction="#openInspectrawmilk" prefHeight="55.0" prefWidth="230.0" text="Inspect Raw Milk" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Button fx:id="monitorproductqualityButton" onAction="#openMonitorproductquality" prefHeight="55.0" prefWidth="230.0" text="Monitor Product Quality" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Button fx:id="qualityreportButton" onAction="#openQualityreport" prefHeight="55.0" prefWidth="230.0" text="Quality Report" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Button fx:id="complaintinvestigationButton" onAction="#openComplaintinvestigation" prefHeight="55.0" prefWidth="230.0" text="Complaint Investigation" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Button fx:id="expirycheckButton" onAction="#openExpirycheck" prefHeight="55.0" prefWidth="230.0" text="Expiry Check" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Button fx:id="sampleevaluationButton" onAction="#openSampleevaluation" prefHeight="55.0" prefWidth="230.0" text="Sample Evaluation" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Button fx:id="hygieneinspectionButton" onAction="#openHygieneinspection" prefHeight="55.0" prefWidth="230.0" text="Hygiene Inspection" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <Button fx:id="labrecordreviewButton" onAction="#openLabrecordreview" prefHeight="55.0" prefWidth="230.0" text="Lab Record Review" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>
      <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#handleLogout" prefHeight="30.0" prefWidth="150.0" text="Back to Main Menu" />
   </children>
</VBox>
