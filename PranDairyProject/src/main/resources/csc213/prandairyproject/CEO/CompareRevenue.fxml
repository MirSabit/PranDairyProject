<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CEO.comparerevenue">
   <children>
      <Text layoutX="20.0" layoutY="30.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Compare Product Revenue" />
      <Text layoutX="52.0" layoutY="80.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Category 1" />
      <TextField fx:id="category1Field" layoutX="130.0" layoutY="62.0" />
      <Text layoutX="300.0" layoutY="80.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Category 2" />
      <TextField fx:id="category2Field" layoutX="378.0" layoutY="62.0" />
      <Button fx:id="compareButton" layoutX="54.0" layoutY="100.0" mnemonicParsing="false" onAction="#compareRevenue" prefHeight="25.0" prefWidth="356.0" text="Compare" />
      <Button fx:id="backButton" layoutX="425.0" layoutY="100.0" mnemonicParsing="false" onAction="#goBack" prefHeight="25.0" prefWidth="105.0" text="Back" />
      <TableView fx:id="comparisonTable" layoutX="52.0" layoutY="150.0" prefHeight="220.0" prefWidth="478.0">
        <columns>
          <TableColumn fx:id="product1Column" prefWidth="239.0" text="Category 1" />
          <TableColumn fx:id="product2Column" prefWidth="239.0" text="Category 2" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
