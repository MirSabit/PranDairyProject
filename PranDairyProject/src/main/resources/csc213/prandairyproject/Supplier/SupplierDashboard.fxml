<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="TOP_CENTER" spacing="25.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Supplier.SupplierDashboard">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Supplier Dashboard">
         <font>
            <Font size="26.0" />
         </font>
      </Text>
      <GridPane alignment="CENTER" hgap="15.0" vgap="15.0">
         <children>
            <Button fx:id="newdeliveryButton" onAction="#openNewdelivery" prefHeight="55.0" prefWidth="230.0" text="New Delivery" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Button fx:id="paymentstatusButton" onAction="#openPaymentstatus" prefHeight="55.0" prefWidth="230.0" text="Payment Status" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Button fx:id="updatesupplyinfoButton" onAction="#openUpdatesupplyinfo" prefHeight="55.0" prefWidth="230.0" text="Update Supply Info" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Button fx:id="deliveryhistoryButton" onAction="#openDeliveryhistory" prefHeight="55.0" prefWidth="230.0" text="Delivery History" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Button fx:id="registerbatchButton" onAction="#openRegisterbatch" prefHeight="55.0" prefWidth="230.0" text="Register Batch" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Button fx:id="scheduledeliveryButton" onAction="#openScheduledelivery" prefHeight="55.0" prefWidth="230.0" text="Schedule Delivery" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Button fx:id="feedbackresponseButton" onAction="#openFeedbackresponse" prefHeight="55.0" prefWidth="230.0" text="Feedback Response" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <Button fx:id="performancereportButton" onAction="#openPerformancereport" prefHeight="55.0" prefWidth="230.0" text="Performance Report" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>
      <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#handleLogout" prefHeight="30.0" prefWidth="150.0" text="Back to Main Menu" />
   </children>
</VBox>
