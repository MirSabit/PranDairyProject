<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>


<AnchorPane prefHeight="560.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Inventory_Manager.inventory">
   <children>
      <Text layoutX="20.0" layoutY="30.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Inventory" />
      <Button fx:id="backButton" layoutX="500.0" layoutY="10.0" mnemonicParsing="false" onAction="#goBack" prefHeight="30.0" prefWidth="130.0" text="Back to Dashboard" />

      <Text layoutX="20.0" layoutY="60.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Add New Stock Entry" />
      <Text layoutX="20.0" layoutY="85.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Stock ID" />
      <TextField fx:id="newStockIdField" layoutX="90.0" layoutY="67.0" prefWidth="80.0" />
      <Text layoutX="185.0" layoutY="85.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Product Name" />
      <TextField fx:id="newProductNameField" layoutX="275.0" layoutY="67.0" prefWidth="110.0" />
      <Text layoutX="20.0" layoutY="120.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Current Stock" />
      <TextField fx:id="newCurrentStockField" layoutX="105.0" layoutY="102.0" prefWidth="65.0" />
      <Text layoutX="185.0" layoutY="120.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Min. Threshold" />
      <TextField fx:id="newMinThresholdField" layoutX="280.0" layoutY="102.0" prefWidth="65.0" />
      <Text layoutX="360.0" layoutY="120.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Location" />
      <TextField fx:id="newLocationField" layoutX="420.0" layoutY="102.0" prefWidth="110.0" />
      <Button fx:id="addStockButton" layoutX="545.0" layoutY="100.0" mnemonicParsing="false" onAction="#addStock" prefHeight="25.0" prefWidth="85.0" text="Add Stock" />

      <Text layoutX="20.0" layoutY="150.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Search (ID or Name)" />
      <TextField fx:id="searchField" layoutX="170.0" layoutY="132.0" prefWidth="150.0" />
      <Button fx:id="searchStockButton" layoutX="330.0" layoutY="132.0" mnemonicParsing="false" onAction="#searchStock" prefHeight="25.0" prefWidth="110.0" text="Search Stock" />
      <Button fx:id="lowStockButton" layoutX="450.0" layoutY="132.0" mnemonicParsing="false" onAction="#viewLowStockAlerts" prefHeight="25.0" prefWidth="90.0" text="Low Stock" />
      <Button fx:id="showAllButton" layoutX="545.0" layoutY="132.0" mnemonicParsing="false" onAction="#showAllStock" prefHeight="25.0" prefWidth="85.0" text="Show All" />

      <TableView fx:id="stockTable" layoutX="20.0" layoutY="170.0" prefHeight="240.0" prefWidth="610.0">
        <columns>
          <TableColumn fx:id="stockIdColumn" prefWidth="80.0" text="Stock ID" />
          <TableColumn fx:id="productNameColumn" prefWidth="130.0" text="Product Name" />
            <TableColumn fx:id="currentStockColumn" prefWidth="100.0" text="Current Stock" />
            <TableColumn fx:id="minThresholdColumn" prefWidth="100.0" text="Min. Threshold" />
            <TableColumn fx:id="locationColumn" prefWidth="100.0" text="Location" />
            <TableColumn fx:id="availabilityColumn" prefWidth="99.0" text="Availability" />
        </columns>
      </TableView>

      <Text layoutX="20.0" layoutY="440.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Quantity" />
      <TextField fx:id="quantityField" layoutX="85.0" layoutY="422.0" prefWidth="80.0" promptText="+/-" />
      <Button fx:id="updateStockButton" layoutX="175.0" layoutY="420.0" mnemonicParsing="false" onAction="#updateStock" prefHeight="25.0" prefWidth="120.0" text="Update Stock" />
      <Button fx:id="restockButton" layoutX="305.0" layoutY="420.0" mnemonicParsing="false" onAction="#restockProduct" prefHeight="25.0" prefWidth="130.0" text="Restock Product" />
      <Button fx:id="changeAvailabilityButton" layoutX="445.0" layoutY="420.0" mnemonicParsing="false" onAction="#changeAvailability" prefHeight="25.0" prefWidth="185.0" text="Change Availability" />
      <Text layoutX="20.0" layoutY="470.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Select a row above, then use the buttons to update it." />
   </children>
</AnchorPane>
