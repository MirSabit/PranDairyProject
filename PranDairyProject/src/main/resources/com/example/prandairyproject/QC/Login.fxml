<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Process-1: Login (shared by all 8 users) -->

<StackPane prefHeight="600" prefWidth="900" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <VBox alignment="CENTER" maxWidth="380" spacing="18" styleClass="form-card">
        <Label style="-fx-text-fill:#0B5E3C;-fx-font-size:26px;" styleClass="header-title" text="PRAN DAIRY" />
        <Label styleClass="section-title" text="Management System - Login" />

        <VBox spacing="6">
            <Label text="User ID (4 or 7 digits)" />
            <TextField fx:id="txtUserId" promptText="Enter your User ID" />
        </VBox>

        <VBox spacing="6">
            <Label text="Password" />
            <PasswordField fx:id="txtPassword" promptText="Enter your password" />
        </VBox>

        <Label fx:id="lblLoginError" style="-fx-text-fill:#C0392B;" text="" wrapText="true" />

        <Button fx:id="btnLogin" maxWidth="Infinity" styleClass="btn-primary" text="Login" />
    </VBox>
</StackPane>
