<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/style.css" prefWidth="950" prefHeight="680">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" spacing="12">
            <Button fx:id="btnBack" text="&lt; Dashboard" styleClass="btn-secondary"/>
            <Label text="Raw Milk Quality Inspection" styleClass="header-title"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="16" style="-fx-padding:20;">
                <VBox styleClass="form-card" spacing="10">
                    <Label text="1. Batch Details" styleClass="section-title"/>
                    <GridPane hgap="12" vgap="10">
                        <Label text="Batch ID" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtBatchId" promptText="e.g. BATCH-20260604-0007" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Supplier Name" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <ComboBox fx:id="cmbSupplierName" promptText="Select Supplier" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                        <Label text="Delivery Date" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <DatePicker fx:id="dpDeliveryDate" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Quantity Received (L)" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <TextField fx:id="txtQuantity" promptText="Litres" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                    </GridPane>
                    <Button fx:id="btnVerifyBatch" text="Verify Batch" styleClass="btn-secondary"/>
                    <Label fx:id="lblBatchStatus" styleClass="status-label"/>
                </VBox>

                <VBox styleClass="form-card" spacing="10">
                    <Label text="2. Laboratory Test Results" styleClass="section-title"/>
                    <GridPane hgap="12" vgap="10">
                        <Label text="Fat Percentage (%)" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtFatPct" promptText="3.5 - 6.0" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="SNF (%)" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <TextField fx:id="txtSnf" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                        <Label text="pH Level" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtPh" promptText="6.6 - 6.8" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Temperature (°C)" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <TextField fx:id="txtTemperature" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                        <Label text="Adulteration Test Result" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cmbAdulteration" GridPane.rowIndex="2" GridPane.columnIndex="1">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Pass"/>
                                    <String fx:value="Fail"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </GridPane>
                    <Label fx:id="lblValidationWarning" style="-fx-text-fill:#C0392B;"/>
                </VBox>

                <VBox styleClass="form-card" spacing="10">
                    <Label text="3. Decision" styleClass="section-title"/>
                    <TextArea fx:id="txtRejectionReason" promptText="Rejection reason (min 10 characters, required if rejecting)" prefRowCount="3"/>
                    <HBox spacing="12">
                        <Button fx:id="btnApprove" text="Approve Batch" styleClass="btn-primary"/>
                        <Button fx:id="btnReject" text="Reject Batch" styleClass="btn-danger"/>
                    </HBox>
                    <Label fx:id="lblResult" styleClass="status-label" wrapText="true"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
