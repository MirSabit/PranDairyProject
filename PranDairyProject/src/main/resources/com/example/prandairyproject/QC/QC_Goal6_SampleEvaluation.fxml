<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<!-- User-5, Goal-6: Sample Evaluation (approve/reject new product samples) -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/style.css" prefWidth="950" prefHeight="700">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" spacing="12">
            <Button fx:id="btnBack" text="&lt; Dashboard" styleClass="btn-secondary"/>
            <Label text="New Product Sample Evaluation" styleClass="header-title"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="16" style="-fx-padding:20;">
                <VBox styleClass="form-card" spacing="10">
                    <Label text="1. Sample Details" styleClass="section-title"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Sample ID"/>
                        <TextField fx:id="txtSampleId" promptText="Enter Sample ID"/>
                        <Button fx:id="btnLoadSample" text="Load Sample" styleClass="btn-secondary"/>
                    </HBox>
                    <GridPane hgap="12" vgap="6">
                        <Label text="Product Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblProductName" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Submitted By:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Label fx:id="lblSubmittedBy" text="-" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                        <Label text="Formulation Details:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="lblFormulation" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Submission Date:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <Label fx:id="lblSubmissionDate" text="-" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                    </GridPane>
                    <Label fx:id="lblAlreadyEvaluated" style="-fx-text-fill:#C0392B;"/>
                </VBox>

                <VBox styleClass="form-card" spacing="10">
                    <Label text="2. Quality Evaluation" styleClass="section-title"/>
                    <GridPane hgap="12" vgap="10">
                        <Label text="Taste Score (1-10)" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Spinner fx:id="spTasteScore" editable="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Texture Score (1-10)" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Spinner fx:id="spTextureScore" editable="true" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                        <Label text="Shelf-Life Test Result (days)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtShelfLife" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Safety Compliance" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <ComboBox fx:id="cmbSafetyCompliance" GridPane.rowIndex="1" GridPane.columnIndex="3">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Pass"/>
                                    <String fx:value="Fail"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </GridPane>
                </VBox>

                <VBox styleClass="form-card" spacing="10">
                    <Label text="3. Decision" styleClass="section-title"/>
                    <TextArea fx:id="txtJustification" promptText="Justification notes (min 15 characters, required if rejecting)" prefRowCount="3"/>
                    <HBox spacing="12">
                        <Button fx:id="btnApproveSample" text="Approve Sample" styleClass="btn-primary"/>
                        <Button fx:id="btnRejectSample" text="Reject Sample" styleClass="btn-danger"/>
                    </HBox>
                    <Label fx:id="lblResult" styleClass="status-label" wrapText="true"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
