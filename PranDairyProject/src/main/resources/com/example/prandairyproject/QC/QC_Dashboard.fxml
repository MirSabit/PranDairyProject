<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- User-5 Dashboard: Quality Control Officer -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/style.css" prefWidth="1000" prefHeight="650">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" spacing="10">
            <Label text="PRAN Dairy - Quality Control Officer Dashboard" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblWelcome" text="Welcome, QC Officer" style="-fx-text-fill:white;"/>
            <Button fx:id="btnLogout" text="Sign Out" styleClass="btn-secondary"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color:transparent;">
            <TilePane hgap="18" vgap="18" prefColumns="4" style="-fx-padding:20;">
                <Button fx:id="btnGoal1" text="Raw Milk Quality Inspection" styleClass="dashboard-tile" wrapText="true" maxWidth="Infinity"/>
                <Button fx:id="btnGoal2" text="Product Quality Monitoring" styleClass="dashboard-tile" wrapText="true" maxWidth="Infinity"/>
                <Button fx:id="btnGoal3" text="Quality Inspection Report" styleClass="dashboard-tile" wrapText="true" maxWidth="Infinity"/>
                <Button fx:id="btnGoal4" text="Complaint Investigation" styleClass="dashboard-tile" wrapText="true" maxWidth="Infinity"/>
                <Button fx:id="btnGoal5" text="Expiry Monitoring" styleClass="dashboard-tile" wrapText="true" maxWidth="Infinity"/>
                <Button fx:id="btnGoal6" text="Sample Evaluation" styleClass="dashboard-tile" wrapText="true" maxWidth="Infinity"/>
                <Button fx:id="btnGoal7" text="Hygiene Monitoring" styleClass="dashboard-tile" wrapText="true" maxWidth="Infinity"/>
                <Button fx:id="btnGoal8" text="Laboratory Records Review" styleClass="dashboard-tile" wrapText="true" maxWidth="Infinity"/>
            </TilePane>
        </ScrollPane>
    </center>
</BorderPane>
