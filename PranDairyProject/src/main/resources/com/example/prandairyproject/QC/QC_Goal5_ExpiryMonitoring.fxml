<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<!-- User-5, Goal-5: Expiry Monitoring -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/style.css" prefWidth="1000" prefHeight="680">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" spacing="12">
            <Button fx:id="btnBack" text="&lt; Dashboard" styleClass="btn-secondary"/>
            <Label text="Product Expiry Monitoring" styleClass="header-title"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="16" style="-fx-padding:20;">
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="form-card">
                <Label text="Product Category"/>
                <ComboBox fx:id="cmbCategory" promptText="Select category">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Milk"/>
                            <String fx:value="Yogurt"/>
                            <String fx:value="Cheese"/>
                            <String fx:value="Butter"/>
                        </FXCollections>
                    </items>
                </ComboBox>
                <Button fx:id="btnSearch" text="Show Batches" styleClass="btn-primary"/>
                <Label fx:id="lblValidation" style="-fx-text-fill:#C0392B;"/>
            </HBox>

            <TableView fx:id="tblExpiryBatches" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colProductName" text="Product Name" prefWidth="180"/>
                    <TableColumn fx:id="colBatchId" text="Batch ID" prefWidth="160"/>
                    <TableColumn fx:id="colCurrentStock" text="Current Stock" prefWidth="120"/>
                    <TableColumn fx:id="colDaysRemaining" text="Days Remaining" prefWidth="130"/>
                    <TableColumn fx:id="colAction" text="Action" prefWidth="200"/>
                </columns>
            </TableView>

            <HBox spacing="12">
                <Button fx:id="btnFlagDiscount" text="Flag for Discount" styleClass="btn-secondary"/>
                <Button fx:id="btnFlagRemoval" text="Flag for Removal" styleClass="btn-danger"/>
                <Button fx:id="btnGenerateAlertReport" text="Generate Expiry Alert Report" styleClass="btn-primary"/>
            </HBox>
            <Label fx:id="lblEmpty" text="" styleClass="status-label"/>
        </VBox>
    </center>
</BorderPane>
