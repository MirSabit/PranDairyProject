<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<!-- User-5, Goal-2: Product Quality Monitoring -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/style.css" prefWidth="950" prefHeight="680">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" spacing="12">
            <Button fx:id="btnBack" text="&lt; Dashboard" styleClass="btn-secondary"/>
            <Label text="Product Quality Monitoring (Pre-Distribution)" styleClass="header-title"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="16" style="-fx-padding:20;">
                <VBox styleClass="form-card" spacing="10">
                    <Label text="1. Select Product Batch" styleClass="section-title"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Product Batch ID"/>
                        <TextField fx:id="txtProductBatchId" promptText="Enter Product Batch ID"/>
                        <Button fx:id="btnLoadBatch" text="Load Batch Info" styleClass="btn-secondary"/>
                    </HBox>
                    <GridPane hgap="12" vgap="6">
                        <Label text="Product Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblProductName" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Production Date:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="lblProductionDate" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Expiry Date:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Label fx:id="lblExpiryDate" text="-" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                        <Label text="Packaging Line:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <Label fx:id="lblPackagingLine" text="-" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                        <Label text="Quantity Produced:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="lblQtyProduced" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    </GridPane>
                    <Label fx:id="lblBatchMismatch" style="-fx-text-fill:#C0392B;"/>
                </VBox>

                <VBox styleClass="form-card" spacing="10">
                    <Label text="2. Packaging Quality Checks" styleClass="section-title"/>
                    <GridPane hgap="12" vgap="10">
                        <Label text="Seal Integrity" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cmbSealIntegrity" GridPane.rowIndex="0" GridPane.columnIndex="1">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Pass"/>
                                    <String fx:value="Fail"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                        <Label text="Label Accuracy" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <ComboBox fx:id="cmbLabelAccuracy" GridPane.rowIndex="0" GridPane.columnIndex="3">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Pass"/>
                                    <String fx:value="Fail"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                        <Label text="Weight/Volume Check" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtWeightCheck" promptText="Must be within ±2% of stated value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    </GridPane>
                </VBox>

                <VBox styleClass="form-card" spacing="10">
                    <Label text="3. Decision" styleClass="section-title"/>
                    <TextArea fx:id="txtHoldRemarks" promptText="Remarks (min 10 characters, required if held for review)" prefRowCount="3"/>
                    <HBox spacing="12">
                        <Button fx:id="btnApproveDistribution" text="Approve for Distribution" styleClass="btn-primary"/>
                        <Button fx:id="btnHoldReview" text="Hold for Review" styleClass="btn-danger"/>
                    </HBox>
                    <Label fx:id="lblResult" styleClass="status-label" wrapText="true"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
