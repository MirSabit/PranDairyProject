<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/style.css" prefWidth="1000" prefHeight="700">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" spacing="12">
            <Button fx:id="btnBack" text="&lt; Dashboard" styleClass="btn-secondary"/>
            <Label text="Hygiene Compliance Monitoring" styleClass="header-title"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="16" style="-fx-padding:20;">
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="form-card">
                <Label text="Inspection Area"/>
                <ComboBox fx:id="cmbArea" promptText="Select area">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Production Floor"/>
                            <String fx:value="Storage"/>
                            <String fx:value="Packaging"/>
                            <String fx:value="Vehicle"/>
                        </FXCollections>
                    </items>
                </ComboBox>
                <Button fx:id="btnLoadChecklist" text="Load Checklist" styleClass="btn-secondary"/>
                <Label fx:id="lblNotDue" style="-fx-text-fill:#C0392B;"/>
            </HBox>

            <TableView fx:id="tblChecklist" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colChecklistItem" text="Checklist Item" prefWidth="300"/>
                    <TableColumn fx:id="colPassFail" text="Pass / Fail" prefWidth="150"/>
                    <TableColumn fx:id="colRemarks" text="Remarks (if Fail, min 10 chars)" prefWidth="320"/>
                </columns>
            </TableView>

            <HBox spacing="20" alignment="CENTER_LEFT" styleClass="form-card">
                <Button fx:id="btnSubmitChecklist" text="Submit Inspection" styleClass="btn-primary"/>
                <Label text="Compliance Score:"/>
                <Label fx:id="lblComplianceScore" text="-" styleClass="section-title"/>
                <Label fx:id="lblComplianceStatus" text="-"/>
            </HBox>
            <Label fx:id="lblValidation" style="-fx-text-fill:#C0392B;"/>
        </VBox>
    </center>
</BorderPane>
