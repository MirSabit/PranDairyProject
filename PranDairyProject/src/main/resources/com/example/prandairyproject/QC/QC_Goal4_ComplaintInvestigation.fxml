<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<!-- User-5, Goal-4: Complaint Investigation -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/style.css" prefWidth="950" prefHeight="700">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" spacing="12">
            <Button fx:id="btnBack" text="&lt; Dashboard" styleClass="btn-secondary"/>
            <Label text="Product Quality Complaint Investigation" styleClass="header-title"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="16" style="-fx-padding:20;">
                <VBox styleClass="form-card" spacing="10">
                    <Label text="1. Select Complaint" styleClass="section-title"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Ticket ID"/>
                        <ComboBox fx:id="cmbTicketId" promptText="Select from quality-related queue" prefWidth="220"/>
                        <Button fx:id="btnLoadComplaint" text="Load Complaint" styleClass="btn-secondary"/>
                    </HBox>
                    <GridPane hgap="12" vgap="6">
                        <Label text="Customer Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblCustomerName" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Product Name:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Label fx:id="lblProductName" text="-" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                        <Label text="Batch ID:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="lblBatchId" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    </GridPane>
                    <Label text="Complaint Description:"/>
                    <TextArea fx:id="txtComplaintDescription" editable="false" prefRowCount="3" wrapText="true"/>
                    <ImageView fx:id="imgAttachment" fitWidth="150" fitHeight="150" preserveRatio="true"/>
                    <Label fx:id="lblUnverified" style="-fx-text-fill:#C0392B;"/>
                </VBox>

                <VBox styleClass="form-card" spacing="10">
                    <Label text="2. Investigation Findings" styleClass="section-title"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Root Cause"/>
                        <ComboBox fx:id="cmbRootCause">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Contamination"/>
                                    <String fx:value="Packaging Defect"/>
                                    <String fx:value="Storage Issue"/>
                                    <String fx:value="Other"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </HBox>
                    <TextArea fx:id="txtInvestigationNotes" promptText="Investigation Notes (min 20 characters)" prefRowCount="3"/>
                </VBox>

                <VBox styleClass="form-card" spacing="10">
                    <Label text="3. Corrective Action" styleClass="section-title"/>
                    <ComboBox fx:id="cmbCorrectiveAction">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Batch Recall"/>
                                <String fx:value="Supplier Warning"/>
                                <String fx:value="No Action Needed"/>
                                <String fx:value="Refund Recommendation"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                    <Button fx:id="btnSubmitInvestigation" text="Submit Investigation" styleClass="btn-primary" maxWidth="220"/>
                    <Label fx:id="lblResult" styleClass="status-label" wrapText="true"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
