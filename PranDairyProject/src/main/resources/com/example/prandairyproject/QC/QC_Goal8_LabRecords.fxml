<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/style.css" prefWidth="1050" prefHeight="700">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" spacing="12">
            <Button fx:id="btnBack" text="&lt; Dashboard" styleClass="btn-secondary"/>
            <Label text="Laboratory Test Records Review" styleClass="header-title"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="16" style="-fx-padding:20;">
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="form-card">
                <Label text="Period"/>
                <ComboBox fx:id="cmbPeriod">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Daily"/>
                            <String fx:value="Weekly"/>
                            <String fx:value="Monthly"/>
                            <String fx:value="Custom"/>
                        </FXCollections>
                    </items>
                </ComboBox>
                <Label text="From"/>
                <DatePicker fx:id="dpFrom"/>
                <Label text="To"/>
                <DatePicker fx:id="dpTo"/>
                <Label text="Test Type"/>
                <ComboBox fx:id="cmbTestTypeFilter">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="All"/>
                            <String fx:value="Fat"/>
                            <String fx:value="SNF"/>
                            <String fx:value="pH"/>
                            <String fx:value="Microbial"/>
                        </FXCollections>
                    </items>
                </ComboBox>
                <Label text="Result"/>
                <ComboBox fx:id="cmbResultFilter">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="All"/>
                            <String fx:value="Pass"/>
                            <String fx:value="Fail"/>
                        </FXCollections>
                    </items>
                </ComboBox>
                <Button fx:id="btnSearch" text="Search" styleClass="btn-primary"/>
            </HBox>

            <TableView fx:id="tblLabRecords" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTestId" text="Test ID" prefWidth="120"/>
                    <TableColumn fx:id="colBatchId" text="Batch ID" prefWidth="150"/>
                    <TableColumn fx:id="colTestType" text="Test Type" prefWidth="110"/>
                    <TableColumn fx:id="colResult" text="Result" prefWidth="90"/>
                    <TableColumn fx:id="colTechnician" text="Technician" prefWidth="150"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="110"/>
                </columns>
            </TableView>

            <HBox spacing="20" alignment="CENTER_LEFT" styleClass="form-card">
                <Label text="Pass Rate:"/>
                <Label fx:id="lblPassRate" text="-"/>
                <Label text="Fail Rate:"/>
                <Label fx:id="lblFailRate" text="-"/>
                <Label text="Most Common Failure:"/>
                <Label fx:id="lblCommonFailure" text="-"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnExport" text="Export" styleClass="btn-secondary"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
