<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="TOP_CENTER" spacing="25.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CEO.ceodashboard">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="CEO Dashboard">
         <font>
            <Font size="26.0" />
         </font>
      </Text>
      <GridPane alignment="CENTER" hgap="15.0" vgap="15.0">
         <children>
            <Button fx:id="weeklySalesButton" onAction="#openWeeklySalesGrowth" prefHeight="55.0" prefWidth="230.0" text="Weekly Sales Growth" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Button fx:id="quaterlySummaryButton" onAction="#openQuaterlySummary" prefHeight="55.0" prefWidth="230.0" text="Quaterly Profit/Loss Summary" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Button fx:id="annualProductionButton" onAction="#openAnnualProduction" prefHeight="55.0" prefWidth="230.0" text="Annual Production Target" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Button fx:id="compareRevenueButton" onAction="#openCompareRevenue" prefHeight="55.0" prefWidth="230.0" text="Compare Product Revenue" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Button fx:id="supplierContractButton" onAction="#openSupplierContract" prefHeight="55.0" prefWidth="230.0" text="Approve Supplier Contract" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Button fx:id="checkOnEmployeeButton" onAction="#openCheckOnEmployee" prefHeight="55.0" prefWidth="230.0" text="Check On Employee" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Button fx:id="complaintsButton" onAction="#openComplaints" prefHeight="55.0" prefWidth="230.0" text="Complaint Resolution Summary" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <Button fx:id="financeButton" onAction="#openFinance" prefHeight="55.0" prefWidth="230.0" text="Finance" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>
      <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#handleLogout" prefHeight="30.0" prefWidth="120.0" text="Logout" />
   </children>
</VBox>
