<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Inventory_Manager.inventory_log">
   <children>
      <Text layoutX="20.0" layoutY="30.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Inventory Deduction Log" />
      <Button fx:id="backButton" layoutX="20.0" layoutY="45.0" mnemonicParsing="false" onAction="#goBack" prefHeight="25.0" prefWidth="140.0" text="Back to Dashboard" />
      <TableView fx:id="logTable" layoutX="20.0" layoutY="90.0" prefHeight="270.0" prefWidth="560.0">
        <columns>
          <TableColumn fx:id="itemIdColumn" prefWidth="100.0" text="Item ID" />
          <TableColumn fx:id="dateColumn" prefWidth="120.0" text="Date" />
            <TableColumn fx:id="quantityChangedColumn" prefWidth="130.0" text="Quantity Changed" />
            <TableColumn fx:id="reasonColumn" prefWidth="210.0" text="Reason" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
