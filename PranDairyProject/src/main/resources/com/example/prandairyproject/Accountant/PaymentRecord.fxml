<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.prandairyproject.Accountant.PaymentRecordController">

    <children>

        <!-- Title -->
        <Label layoutX="410.0" layoutY="20.0" text="Payment Records">
            <font>
                <Font size="26.0"/>
            </font>
        </Label>

        <!-- Search Panel -->
        <VBox layoutX="30.0"
              layoutY="70.0"
              prefWidth="300.0"
              spacing="12.0">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="From Date"/>

            <DatePicker fx:id="fromDatePicker"
                        prefWidth="250.0"/>

            <Label text="To Date"/>

            <DatePicker fx:id="toDatePicker"
                        prefWidth="250.0"/>

            <Label text="Payment Method"/>

            <ComboBox fx:id="paymentMethodComboBox"
                      prefWidth="250.0"
                      promptText="Select Payment Method"/>

            <Label text="Status"/>

            <ComboBox fx:id="statusComboBox"
                      prefWidth="250.0"
                      promptText="Select Status"/>

            <HBox spacing="10">

                <Button fx:id="searchButton"
                        prefWidth="80.0"
                        text="Search"
                        onAction="#onSearchButtonClick"/>

                <Button fx:id="verifyButton"
                        prefWidth="80.0"
                        text="Verify"
                        onAction="#onVerifyButtonClick"/>

                <Button fx:id="flagButton"
                        prefWidth="90.0"
                        text="Flag Review"
                        onAction="#onFlagButtonClick"/>

            </HBox>

            <Button fx:id="backButton"
                    prefWidth="120.0"
                    text="Back"
                    onAction="#onBackButtonClick"/>

        </VBox>

        <!-- Payment Records Table -->
        <TableView fx:id="paymentTableView"
                   layoutX="350.0"
                   layoutY="70.0"
                   prefHeight="590.0"
                   prefWidth="720.0">

            <columns>

                <TableColumn fx:id="transactionIdColumn"
                             prefWidth="120.0"
                             text="Transaction ID"/>

                <TableColumn fx:id="customerIdColumn"
                             prefWidth="100.0"
                             text="Customer ID"/>

                <TableColumn fx:id="orderIdColumn"
                             prefWidth="100.0"
                             text="Order ID"/>

                <TableColumn fx:id="amountColumn"
                             prefWidth="90.0"
                             text="Amount"/>

                <TableColumn fx:id="paymentMethodColumn"
                             prefWidth="110.0"
                             text="Method"/>

                <TableColumn fx:id="paymentDateColumn"
                             prefWidth="110.0"
                             text="Date"/>

                <TableColumn fx:id="statusColumn"
                             prefWidth="90.0"
                             text="Status"/>

            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

        </TableView>

    </children>

</AnchorPane>