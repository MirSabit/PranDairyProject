<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0"
            prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.prandairyproject.Accountant.SalaryProcessingController">

    <children>

        <!-- Title -->
        <Label layoutX="410.0" layoutY="20.0" text="Salary Processing">
            <font>
                <Font size="26.0"/>
            </font>
        </Label>

        <!-- Filter Section -->
        <VBox layoutX="40.0"
              layoutY="70.0"
              prefWidth="300.0"
              spacing="15.0">

            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>

            <Label text="Month"/>

            <ComboBox fx:id="monthComboBox"
                      prefWidth="250.0"
                      promptText="Select Month"/>

            <Label text="Year"/>

            <ComboBox fx:id="yearComboBox"
                      prefWidth="250.0"
                      promptText="Select Year"/>

            <Button text="Load Salaries"
                    prefWidth="150.0"
                    onAction="#onLoadButtonClick"/>

        </VBox>

        <!-- Salary Table -->
        <TableView fx:id="salaryTableView"
                   layoutX="360.0"
                   layoutY="70.0"
                   prefHeight="520.0"
                   prefWidth="710.0">

            <columns>

                <TableColumn fx:id="employeeIdColumn"
                             text="Employee ID"
                             prefWidth="110.0"/>

                <TableColumn fx:id="employeeNameColumn"
                             text="Name"
                             prefWidth="140.0"/>

                <TableColumn fx:id="roleColumn"
                             text="Role"
                             prefWidth="120.0"/>

                <TableColumn fx:id="baseSalaryColumn"
                             text="Base Salary"
                             prefWidth="110.0"/>

                <TableColumn fx:id="bonusColumn"
                             text="Bonus"
                             prefWidth="90.0"/>

                <TableColumn fx:id="deductionColumn"
                             text="Deductions"
                             prefWidth="100.0"/>

                <TableColumn fx:id="netSalaryColumn"
                             text="Net Salary"
                             prefWidth="100.0"/>

            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

        </TableView>

        <!-- Bottom Buttons -->
        <HBox layoutX="360.0"
              layoutY="620.0"
              spacing="20.0">

            <Button text="Process Salary"
                    prefWidth="150.0"
                    onAction="#onProcessButtonClick"/>

            <Button text="Clear"
                    prefWidth="120.0"
                    onAction="#onClearButtonClick"/>

            <Button text="Back"
                    prefWidth="120.0"
                    onAction="#onBackButtonClick"/>

        </HBox>

    </children>

</AnchorPane>