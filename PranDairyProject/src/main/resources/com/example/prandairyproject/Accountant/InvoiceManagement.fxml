<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0"
            prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.prandairyproject.Accountant.InvoiceManagementController">

    <children>

        <!-- Title -->
        <Label layoutX="420.0"
               layoutY="20.0"
               text="Invoice Management">
            <font>
                <Font size="26.0"/>
            </font>
        </Label>

        <!-- Left Panel -->
        <VBox layoutX="30.0"
              layoutY="70.0"
              prefWidth="300.0"
              spacing="15.0">

            <padding>
                <Insets top="10.0"
                        right="10.0"
                        bottom="10.0"
                        left="10.0"/>
            </padding>

            <!-- Customer -->
            <Label text="Customer"/>

            <ComboBox fx:id="customerComboBox"
                      prefWidth="250.0"
                      promptText="Select Customer"/>

            <!-- Status -->
            <Label text="Status"/>

            <ComboBox fx:id="statusComboBox"
                      prefWidth="250.0"
                      promptText="Select Status"/>

            <Separator/>

            <!-- Buttons -->
            <Button text="Load Invoices"
                    prefWidth="170.0"
                    onAction="#onLoadButtonClick"/>

            <Button text="Update Status"
                    prefWidth="170.0"
                    onAction="#onUpdateStatusButtonClick"/>

            <Button text="Clear"
                    prefWidth="170.0"
                    onAction="#onClearButtonClick"/>

            <Button text="Back"
                    prefWidth="170.0"
                    onAction="#onBackButtonClick"/>

        </VBox>

        <!-- TableView -->
        <TableView fx:id="invoiceTableView"
                   layoutX="350.0"
                   layoutY="70.0"
                   prefHeight="600.0"
                   prefWidth="720.0">

            <columns>

                <TableColumn fx:id="invoiceIdColumn"
                             text="Invoice ID"
                             prefWidth="110.0"/>

                <TableColumn fx:id="customerColumn"
                             text="Customer"
                             prefWidth="120.0"/>

                <TableColumn fx:id="orderIdColumn"
                             text="Order ID"
                             prefWidth="100.0"/>

                <TableColumn fx:id="amountColumn"
                             text="Amount"
                             prefWidth="90.0"/>

                <TableColumn fx:id="issueDateColumn"
                             text="Issue Date"
                             prefWidth="110.0"/>

                <TableColumn fx:id="dueDateColumn"
                             text="Due Date"
                             prefWidth="110.0"/>

                <TableColumn fx:id="statusColumn"
                             text="Status"
                             prefWidth="90.0"/>

            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

        </TableView>

    </children>

</AnchorPane>