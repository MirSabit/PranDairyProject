<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>


<AnchorPane prefHeight="473.0" prefWidth="560.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="QualityControlOfficer.complaintinvestigation">
    <Text layoutX="20.0" layoutY="35.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Complaint Investigation">
        <font>
          <Font size="20.0"/>
        </font>
    </Text>
    <Text layoutX="20.0" layoutY="75.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Ticket ID"/>
    <TextField fx:id="ticketIdField" layoutX="180.0" layoutY="60.0" prefWidth="200.0"/>
    <Text layoutX="20.0" layoutY="107.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Customer Name"/>
    <TextField fx:id="customerNameField" layoutX="180.0" layoutY="92.0" prefWidth="200.0"/>
    <Text layoutX="20.0" layoutY="139.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Product Name"/>
    <TextField fx:id="productNameField" layoutX="180.0" layoutY="124.0" prefWidth="200.0"/>
    <Text layoutX="20.0" layoutY="171.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Root Cause"/>
    <TextField fx:id="rootCauseField" layoutX="180.0" layoutY="156.0" prefWidth="200.0"/>
    <Text layoutX="20.0" layoutY="203.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Corrective Action"/>
    <TextField fx:id="correctiveActionField" layoutX="180.0" layoutY="188.0" prefWidth="200.0"/>
    <Button fx:id="addButton" layoutX="20.0" layoutY="228.0" mnemonicParsing="false" onAction="#addRecord"
            prefHeight="30.0" prefWidth="360.0" text="Add"/>
    <TableView fx:id="recordTable" layoutX="20.0" layoutY="273.0" prefHeight="180.0" prefWidth="520.0">
      <columns>
          <TableColumn fx:id="ticketIdColumn" prefWidth="100.0" text="Ticket ID"/>
          <TableColumn fx:id="customerNameColumn" prefWidth="100.0" text="Customer"/>
          <TableColumn fx:id="productNameColumn" prefWidth="100.0" text="Product"/>
          <TableColumn fx:id="rootCauseColumn" prefWidth="100.0" text="Root Cause"/>
          <TableColumn fx:id="correctiveActionColumn" prefWidth="100.0" text="Action"/>
      </columns>
    </TableView>
    <Button fx:id="backButton" layoutX="390.0" layoutY="15.0" mnemonicParsing="false" onAction="#goBack"
            prefHeight="25.0" prefWidth="150.0" text="Back to Dashboard"/>
</AnchorPane>
