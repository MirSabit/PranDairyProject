<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="658.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.prandairyproject.Marketing_Officer.NotificationController">
   <children>
      <Label layoutX="33.0" layoutY="71.0" text="Notification Title" />
      <Label layoutX="153.0" layoutY="28.0" prefHeight="35.0" prefWidth="285.0" text="Notification Manager">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <TextField fx:id="titleTextField" layoutX="130.0" layoutY="67.0" />
      <Label layoutX="53.0" layoutY="122.0" text="Recipient" />
      <ComboBox fx:id="recipientComboBox" layoutX="121.0" layoutY="118.0" prefWidth="150.0" />
      <Label layoutX="45.0" layoutY="170.0" text="Message" />
      <TextArea fx:id="messageTextArea" layoutX="105.0" layoutY="159.0" prefHeight="58.0" prefWidth="441.0" />
      <Label layoutX="33.0" layoutY="245.0" text="Send Date" />
      <DatePicker fx:id="sendDatePicker" layoutX="109.0" layoutY="241.0" />
      <Button fx:id="sendButton" layoutX="35.0" layoutY="285.0" mnemonicParsing="false" onAction="#onSendButtonClick" prefHeight="25.0" prefWidth="116.0" text="Send" />
      <Button fx:id="clearButton" layoutX="205.0" layoutY="285.0" mnemonicParsing="false" onAction="#onClearButtonClick" prefHeight="25.0" prefWidth="116.0" text="Clear" />
      <Button fx:id="backButton" layoutX="376.0" layoutY="285.0" mnemonicParsing="false" onAction="#onBackButtonClick" prefHeight="25.0" prefWidth="136.0" text="Back" />
      <TableView fx:id="notificationTableView" layoutX="99.0" layoutY="346.0" prefHeight="200.0" prefWidth="403.0">
        <columns>
          <TableColumn fx:id="notificationIdColumn" prefWidth="106.0" text="Notification ID" />
          <TableColumn fx:id="titleColumn" prefWidth="53.0" text="Title" />
            <TableColumn fx:id="recipientColumn" prefWidth="77.0" text="Recipient" />
            <TableColumn fx:id="sendDateColumn" prefWidth="77.0" text="Send Date" />
            <TableColumn fx:id="statusColumn" prefWidth="77.0" text="Status" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
