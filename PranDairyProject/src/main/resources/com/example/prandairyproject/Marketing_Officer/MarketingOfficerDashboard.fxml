<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.prandairyproject.Marketing_Officer.MarketingOfficerDashboardController">
   <children>
      <Label layoutX="128.0" layoutY="23.0" text="   Marketing Officer Dashboard">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <Button fx:id="campaignButton" layoutX="91.0" layoutY="90.0" mnemonicParsing="false" onAction="#onCampaignButtonClick" prefHeight="25.0" prefWidth="139.0" text=" Campaign" />
      <Button fx:id="loyaltyButton" layoutX="91.0" layoutY="138.0" mnemonicParsing="false" onAction="#onLoyaltyButtonClick" prefHeight="25.0" prefWidth="139.0" text="Loyalty Program " />
      <Button fx:id="analyticsButton" layoutX="91.0" layoutY="188.0" mnemonicParsing="false" onAction="#onAnalyticsButtonClick" prefHeight="25.0" prefWidth="139.0" text="  Customer Analytics" />
      <Button fx:id="advertisementButton" layoutX="91.0" layoutY="243.0" mnemonicParsing="false" onAction="#onAdvertisementButtonClick" prefHeight="25.0" prefWidth="139.0" text=" Advertisement " />
      <Button fx:id="promotionalButton" layoutX="343.0" layoutY="95.0" mnemonicParsing="false" onAction="#onPromotionalOfferButtonClick" prefHeight="25.0" prefWidth="139.0" text="Promotional Offer" />
      <Button fx:id="couponButton" layoutX="343.0" layoutY="143.0" mnemonicParsing="false" onAction="#onCouponButtonClick" prefHeight="25.0" prefWidth="139.0" text="   Coupon" />
      <Button fx:id="notificationButton" layoutX="343.0" layoutY="193.0" mnemonicParsing="false" onAction="#onNotificationButtonClick" prefHeight="25.0" prefWidth="139.0" text=" Notification" />
      <Button fx:id="reportButton" layoutX="343.0" layoutY="248.0" mnemonicParsing="false" onAction="#onReportButtonClick" prefHeight="25.0" prefWidth="139.0" text=" Marketing Report" />
      <Button fx:id="logoutButton" layoutX="185.0" layoutY="295.0" mnemonicParsing="false" onAction="#onLogoutButtonClick" prefHeight="25.0" prefWidth="201.0" text="Logout" />
      <Label layoutX="166.0" layoutY="355.0" prefHeight="20.0" prefWidth="268.0" text="Manage marketing related tasks from here">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
