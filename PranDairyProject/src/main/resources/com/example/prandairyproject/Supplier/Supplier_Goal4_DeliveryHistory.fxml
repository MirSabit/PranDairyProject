<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/style.css" prefWidth="1000" prefHeight="680">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" spacing="12">
            <Button fx:id="btnBack" text="&lt; Dashboard" styleClass="btn-secondary"/>
            <Label text="My Delivery History" styleClass="header-title"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="16" style="-fx-padding:20;">
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="form-card">
                <Label text="From"/>
                <DatePicker fx:id="dpFrom"/>
                <Label text="To"/>
                <DatePicker fx:id="dpTo"/>
                <Button fx:id="btnSearch" text="Search" styleClass="btn-primary"/>
            </HBox>
            <Label fx:id="lblValidation" style="-fx-text-fill:#C0392B;"/>

            <TableView fx:id="tblDeliveryHistory" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colDeliveryId" text="Delivery ID" prefWidth="150"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="110"/>
                    <TableColumn fx:id="colQuantity" text="Quantity (L)" prefWidth="110"/>
                    <TableColumn fx:id="colInspectionResult" text="Inspection Result" prefWidth="150"/>
                    <TableColumn fx:id="colQcRemarks" text="QC Remarks" prefWidth="250"/>
                </columns>
            </TableView>

            <HBox spacing="20" alignment="CENTER_LEFT" styleClass="form-card">
                <Label text="Total Deliveries:"/>
                <Label fx:id="lblTotalDeliveries" text="-"/>
                <Label text="Total Quantity Supplied:"/>
                <Label fx:id="lblTotalQuantity" text="-"/>
                <Label text="Rejection Rate:"/>
                <Label fx:id="lblRejectionRate" text="-"/>
            </HBox>
            <Label fx:id="lblEmpty" styleClass="status-label"/>
        </VBox>
    </center>
</BorderPane>
