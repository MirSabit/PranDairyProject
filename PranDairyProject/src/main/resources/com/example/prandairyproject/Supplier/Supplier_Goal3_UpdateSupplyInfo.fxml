<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/style.css" prefWidth="900" prefHeight="650">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" spacing="12">
            <Button fx:id="btnBack" text="&lt; Dashboard" styleClass="btn-secondary"/>
            <Label text="Update Supply Information" styleClass="header-title"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="16" style="-fx-padding:20;">
            <VBox styleClass="form-card" spacing="10">
                <Label text="1. Select Supply Record" styleClass="section-title"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Record ID"/>
                    <ComboBox fx:id="cmbRecordId" promptText="Select your supply record" prefWidth="220"/>
                    <Button fx:id="btnLoadRecord" text="Load Record" styleClass="btn-secondary"/>
                </HBox>
                <Label fx:id="lblNotOwned" style="-fx-text-fill:#C0392B;"/>
            </VBox>

            <VBox styleClass="form-card" spacing="10">
                <Label text="2. Current / Updated Information" styleClass="section-title"/>
                <GridPane hgap="14" vgap="10">
                    <Label text="Product Type:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="lblProductType" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Delivery Frequency:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <Label fx:id="lblDeliveryFrequency" text="-" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                    <Label text="Agreed Price" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtPrice" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Contact Number" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <TextField fx:id="txtContactNumber" promptText="11 digits, starts with 01" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                </GridPane>
                <Label fx:id="lblValidation" style="-fx-text-fill:#C0392B;"/>
            </VBox>

            <Button fx:id="btnSaveChanges" text="Save Changes" styleClass="btn-primary" maxWidth="200"/>
            <Label fx:id="lblConfirmation" styleClass="status-label" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
