<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/style.css" prefWidth="900" prefHeight="680">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" spacing="12">
            <Button fx:id="btnBack" text="&lt; Dashboard" styleClass="btn-secondary"/>
            <Label text="Register New Supply Batch" styleClass="header-title"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="16" style="-fx-padding:20;">
            <VBox styleClass="form-card" spacing="10">
                <Label text="Supplier (auto-filled)" styleClass="section-title"/>
                <GridPane hgap="14" vgap="6">
                    <Label text="Supplier Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="lblSupplierName" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Supplier ID:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <Label fx:id="lblSupplierId" text="-" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                </GridPane>
                <Label fx:id="lblExpiredCert" style="-fx-text-fill:#C0392B;"/>
            </VBox>

            <VBox styleClass="form-card" spacing="10">
                <Label text="Batch Information" styleClass="section-title"/>
                <GridPane hgap="14" vgap="10">
                    <Label text="Product Type" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtProductType" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Estimated Quantity" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <TextField fx:id="txtEstimatedQuantity" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                    <Label text="Farm / Source Location" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtSourceLocation" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label text="Intended Delivery Date" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <DatePicker fx:id="dpIntendedDelivery" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                </GridPane>
                <Label fx:id="lblValidation" style="-fx-text-fill:#C0392B;"/>
            </VBox>

            <Button fx:id="btnReviewConfirm" text="Review &amp; Confirm" styleClass="btn-secondary" maxWidth="200"/>
            <Button fx:id="btnSubmitBatch" text="Register Batch" styleClass="btn-primary" maxWidth="200"/>
            <Label fx:id="lblConfirmation" styleClass="status-label" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
