<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- User-6 Dashboard: Supplier -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/style.css" prefWidth="1000" prefHeight="650">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" spacing="10">
            <Label text="PRAN Dairy - Supplier Portal Dashboard" styleClass="header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblWelcome" text="Welcome, Supplier" style="-fx-text-fill:white;"/>
            <Button fx:id="btnLogout" text="Sign Out" styleClass="btn-secondary"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color:transparent;">
            <TilePane hgap="18" vgap="18" prefColumns="4" style="-fx-padding:20;">
                <Button fx:id="btnGoal1" text="New Delivery Submission" styleClass="dashboard-tile" wrapText="true" maxWidth="Infinity"/>
                <Button fx:id="btnGoal2" text="Payment Status" styleClass="dashboard-tile" wrapText="true" maxWidth="Infinity"/>
                <Button fx:id="btnGoal3" text="Update Supply Information" styleClass="dashboard-tile" wrapText="true" maxWidth="Infinity"/>
                <Button fx:id="btnGoal4" text="Delivery History" styleClass="dashboard-tile" wrapText="true" maxWidth="Infinity"/>
                <Button fx:id="btnGoal5" text="Batch Registration" styleClass="dashboard-tile" wrapText="true" maxWidth="Infinity"/>
                <Button fx:id="btnGoal6" text="Delivery Schedule" styleClass="dashboard-tile" wrapText="true" maxWidth="Infinity"/>
                <Button fx:id="btnGoal7" text="Quality Feedback Response" styleClass="dashboard-tile" wrapText="true" maxWidth="Infinity"/>
                <Button fx:id="btnGoal8" text="Performance Report" styleClass="dashboard-tile" wrapText="true" maxWidth="Infinity"/>
            </TilePane>
        </ScrollPane>
    </center>
</BorderPane>
