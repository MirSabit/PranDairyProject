<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- User-6, Goal-7: Response to Quality Feedback -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/style.css" prefWidth="900" prefHeight="680">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" spacing="12">
            <Button fx:id="btnBack" text="&lt; Dashboard" styleClass="btn-secondary"/>
            <Label text="Respond to Quality Feedback" styleClass="header-title"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="16" style="-fx-padding:20;">
            <VBox styleClass="form-card" spacing="10">
                <Label text="1. Select Feedback Record" styleClass="section-title"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Feedback ID / Batch ID"/>
                    <ComboBox fx:id="cmbFeedbackId" promptText="Select flagged feedback record" prefWidth="240"/>
                    <Button fx:id="btnLoadFeedback" text="Load Feedback" styleClass="btn-secondary"/>
                </HBox>
                <GridPane hgap="14" vgap="6">
                    <Label text="Batch ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="lblBatchId" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="Severity:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <Label fx:id="lblSeverity" text="-" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                    <Label text="Date Raised:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="lblDateRaised" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                </GridPane>
                <Label text="QC Officer's Findings:"/>
                <TextArea fx:id="txtQcFindings" editable="false" prefRowCount="3" wrapText="true"/>
                <Label fx:id="lblMismatch" style="-fx-text-fill:#C0392B;"/>
            </VBox>

            <VBox styleClass="form-card" spacing="10">
                <Label text="2. Your Response" styleClass="section-title"/>
                <Label text="Explanation (min 20 characters)"/>
                <TextArea fx:id="txtExplanation" prefRowCount="3"/>
                <Label text="Corrective Measures Planned"/>
                <TextArea fx:id="txtCorrectiveMeasures" prefRowCount="3"/>
                <Button fx:id="btnSubmitResponse" text="Submit Response" styleClass="btn-primary" maxWidth="200"/>
                <Label fx:id="lblConfirmation" styleClass="status-label" wrapText="true"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
