<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/style.css" prefWidth="900" prefHeight="650">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" spacing="12">
            <Button fx:id="btnBack" text="&lt; Dashboard" styleClass="btn-secondary"/>
            <Label text="Delivery Schedule" styleClass="header-title"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="16" style="-fx-padding:20;">
            <VBox styleClass="form-card" spacing="10">
                <Label text="Select Preferred Date" styleClass="section-title"/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Delivery Date"/>
                    <DatePicker fx:id="dpPreferredDate"/>
                    <Button fx:id="btnCheckAvailability" text="Check Available Slots" styleClass="btn-secondary"/>
                </HBox>
                <Label fx:id="lblFullyBooked" style="-fx-text-fill:#C0392B;"/>
            </VBox>

            <VBox styleClass="form-card" spacing="10">
                <Label text="Available Time Slots" styleClass="section-title"/>
                <ListView fx:id="lvTimeSlots" prefHeight="180"/>
                <Label text="Estimated Quantity (for planning)"/>
                <TextField fx:id="txtEstimatedQuantity" maxWidth="220"/>
            </VBox>

            <Button fx:id="btnConfirmSlot" text="Confirm Schedule" styleClass="btn-primary" maxWidth="200"/>
            <Label fx:id="lblConfirmation" styleClass="status-label" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
