<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<!-- User-6, Goal-2: Payment Status -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            stylesheets="@../css/style.css" prefWidth="1000" prefHeight="680">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" spacing="12">
            <Button fx:id="btnBack" text="&lt; Dashboard" styleClass="btn-secondary"/>
            <Label text="Payment Status" styleClass="header-title"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="16" style="-fx-padding:20;">
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="form-card">
                <Label text="From"/>
                <DatePicker fx:id="dpFrom"/>
                <Label text="To"/>
                <DatePicker fx:id="dpTo"/>
                <Label text="Status"/>
                <ComboBox fx:id="cmbStatus">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="All"/>
                            <String fx:value="Paid"/>
                            <String fx:value="Pending"/>
                        </FXCollections>
                    </items>
                </ComboBox>
                <Button fx:id="btnSearch" text="Search" styleClass="btn-primary"/>
            </HBox>
            <Label fx:id="lblValidation" style="-fx-text-fill:#C0392B;"/>

            <TableView fx:id="tblPayments" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colPaymentId" text="Payment ID" prefWidth="130"/>
                    <TableColumn fx:id="colPoNumber" text="Purchase Order No." prefWidth="160"/>
                    <TableColumn fx:id="colAmount" text="Amount (BDT)" prefWidth="130"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="110"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="110"/>
                </columns>
            </TableView>

            <HBox spacing="20" alignment="CENTER_LEFT" styleClass="form-card">
                <Label text="Total Paid:"/>
                <Label fx:id="lblTotalPaid" text="-"/>
                <Label text="Total Pending:"/>
                <Label fx:id="lblTotalPending" text="-"/>
                <Label text="Next Expected Payment:"/>
                <Label fx:id="lblNextPayment" text="-"/>
            </HBox>
            <Label fx:id="lblEmpty" styleClass="status-label"/>
        </VBox>
    </center>
</BorderPane>
