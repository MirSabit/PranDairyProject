<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="25.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.prandairyproject.MainMenu">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Pran Dairy">
         <font>
            <Font size="28.0" />
         </font>
      </Text>
      <Button fx:id="qcButton" onAction="#openQualityControlOfficer" prefHeight="55.0" prefWidth="280.0" text="Quality Control Officer" />
      <Button fx:id="supplierButton" onAction="#openSupplier" prefHeight="55.0" prefWidth="280.0" text="Supplier" />
   </children>
</VBox>
