<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0"
            prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.prandairyproject.Accountant.ExpenseManagementController">

    <children>

        <!-- Title -->
        <Label layoutX="410.0" layoutY="20.0" text="Expense Management">
            <font>
                <Font size="26.0"/>
            </font>
        </Label>

        <!-- Left Form -->
        <VBox layoutX="25.0"
              layoutY="70.0"
              prefWidth="310.0"
              spacing="12.0">

            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>

            <!-- Category -->
            <Label text="Category"/>

            <ComboBox fx:id="categoryComboBox"
                      prefWidth="260.0"
                      promptText="Select Category"/>

            <!-- Description -->
            <Label text="Description"/>

            <TextField fx:id="descriptionTextField"
                       prefWidth="260.0"
                       promptText="Enter Description"/>

            <!-- Amount -->
            <Label text="Amount (BDT)"/>

            <TextField fx:id="amountTextField"
                       prefWidth="260.0"
                       promptText="Enter Amount"/>

            <!-- Date -->
            <Label text="Date"/>

            <DatePicker fx:id="datePicker"
                        prefWidth="260.0"/>

            <!-- Paid To -->
            <Label text="Paid To"/>

            <TextField fx:id="paidToTextField"
                       prefWidth="260.0"
                       promptText="Enter Recipient"/>

            <!-- Buttons -->
            <HBox spacing="10">

                <Button text="Save"
                        prefWidth="80.0"
                        onAction="#onSaveButtonClick"/>

                <Button text="Clear"
                        prefWidth="80.0"
                        onAction="#onClearButtonClick"/>

                <Button text="Back"
                        prefWidth="80.0"
                        onAction="#onBackButtonClick"/>

            </HBox>

        </VBox>

        <!-- Expense Table -->
        <TableView fx:id="expenseTableView"
                   layoutX="360.0"
                   layoutY="70.0"
                   prefHeight="600.0"
                   prefWidth="710.0">

            <columns>

                <TableColumn fx:id="expenseIdColumn"
                             text="Expense ID"
                             prefWidth="110.0"/>

                <TableColumn fx:id="categoryColumn"
                             text="Category"
                             prefWidth="120.0"/>

                <TableColumn fx:id="descriptionColumn"
                             text="Description"
                             prefWidth="170.0"/>

                <TableColumn fx:id="amountColumn"
                             text="Amount"
                             prefWidth="90.0"/>

                <TableColumn fx:id="dateColumn"
                             text="Date"
                             prefWidth="100.0"/>

                <TableColumn fx:id="paidToColumn"
                             text="Paid To"
                             prefWidth="120.0"/>

            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

        </TableView>

    </children>

</AnchorPane>