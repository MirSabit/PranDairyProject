<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="700.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.prandairyproject.Accountant.AccountantDashboardController">

    <Label layoutX="210.0" layoutY="20.0" text="Accountant Dashboard">
        <font>
            <Font size="28"/>
        </font>
    </Label>

    <Button layoutX="60" layoutY="90"
            prefWidth="180"
            text="Payment Records"
            onAction="#onPaymentRecordsButtonClick"/>

    <Button layoutX="260" layoutY="90"
            prefWidth="180"
            text="Expense Management"
            onAction="#onExpenseManagementButtonClick"/>

    <Button layoutX="460" layoutY="90"
            prefWidth="180"
            text="Salary Processing"
            onAction="#onSalaryProcessingButtonClick"/>

    <Button layoutX="60" layoutY="180"
            prefWidth="180"
            text="Financial Reports"
            onAction="#onFinancialReportsButtonClick"/>

    <Button layoutX="260" layoutY="180"
            prefWidth="180"
            text="Budget Management"
            onAction="#onBudgetManagementButtonClick"/>

    <Button layoutX="460" layoutY="180"
            prefWidth="180"
            text="Invoice Management"
            onAction="#onInvoiceManagementButtonClick"/>

    <Button layoutX="60" layoutY="270"
            prefWidth="180"
            text="Supplier Payments"
            onAction="#onSupplierPaymentsButtonClick"/>

    <Button layoutX="260" layoutY="270"
            prefWidth="180"
            text="Financial Dashboard"
            onAction="#onFinancialDashboardButtonClick"/>

    <Button layoutX="460" layoutY="270"
            prefWidth="180"
            text="Logout"
            onAction="#onLogoutButtonClick"/>

</AnchorPane>