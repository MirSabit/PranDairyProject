<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0"
            prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.prandairyproject.Accountant.FinancialDashboardController">

    <children>

        <!-- Title -->
        <Label layoutX="400.0"
               layoutY="20.0"
               text="Financial Dashboard">
            <font>
                <Font size="26.0"/>
            </font>
        </Label>

        <!-- Summary Panel -->
        <GridPane layoutX="30.0"
                  layoutY="70.0"
                  hgap="20.0"
                  vgap="15.0">

            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>

            <!-- Revenue -->
            <Label text="Revenue"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="0"/>

            <Label fx:id="revenueLabel"
                   text="0.00"
                   GridPane.rowIndex="0"
                   GridPane.columnIndex="1"/>

            <!-- Expenses -->
            <Label text="Expenses"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="0"/>

            <Label fx:id="expensesLabel"
                   text="0.00"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>

            <!-- Net Profit -->
            <Label text="Net Profit"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="0"/>

            <Label fx:id="netProfitLabel"
                   text="0.00"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="1"/>

            <!-- Budget Used -->
            <Label text="Budget Used"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="0"/>

            <Label fx:id="budgetUsedLabel"
                   text="0.00"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="1"/>

            <!-- Pending Invoices -->
            <Label text="Pending Invoices"
                   GridPane.rowIndex="4"
                   GridPane.columnIndex="0"/>

            <Label fx:id="pendingInvoicesLabel"
                   text="0"
                   GridPane.rowIndex="4"
                   GridPane.columnIndex="1"/>

            <!-- Unpaid Supplier Payments -->
            <Label text="Unpaid Supplier Payments"
                   GridPane.rowIndex="5"
                   GridPane.columnIndex="0"/>

            <Label fx:id="unpaidSupplierLabel"
                   text="0"
                   GridPane.rowIndex="5"
                   GridPane.columnIndex="1"/>

        </GridPane>

        <!-- Dashboard Table -->
        <TableView fx:id="dashboardTableView"
                   layoutX="360.0"
                   layoutY="70.0"
                   prefHeight="520.0"
                   prefWidth="700.0">

            <columns>

                <TableColumn fx:id="categoryColumn"
                             text="Category"
                             prefWidth="350.0"/>

                <TableColumn fx:id="amountColumn"
                             text="Amount"
                             prefWidth="350.0"/>

            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

        </TableView>

        <!-- Bottom Buttons -->
        <HBox layoutX="720.0"
              layoutY="620.0"
              spacing="20.0">

            <Button text="Refresh"
                    prefWidth="120.0"
                    onAction="#onRefreshButtonClick"/>

            <Button text="Back"
                    prefWidth="120.0"
                    onAction="#onBackButtonClick"/>

        </HBox>

    </children>

</AnchorPane>