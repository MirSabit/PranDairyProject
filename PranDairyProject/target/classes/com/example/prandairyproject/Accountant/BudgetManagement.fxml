<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0"
            prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.prandairyproject.Accountant.BudgetManagementController">

    <children>

        <!-- Title -->
        <Label layoutX="410.0" layoutY="20.0" text="Budget Management">
            <font>
                <Font size="26.0"/>
            </font>
        </Label>

        <!-- Budget Entry Form -->
        <VBox layoutX="30.0"
              layoutY="70.0"
              prefWidth="300.0"
              spacing="12.0">

            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>

            <!-- Month -->
            <Label text="Month"/>

            <ComboBox fx:id="monthComboBox"
                      prefWidth="250.0"
                      promptText="Select Month"/>

            <!-- Raw Materials -->
            <Label text="Raw Materials"/>

            <TextField fx:id="rawMaterialsTextField"
                       prefWidth="250.0"
                       promptText="Enter Raw Materials Budget"/>

            <!-- Equipment -->
            <Label text="Equipment"/>

            <TextField fx:id="equipmentTextField"
                       prefWidth="250.0"
                       promptText="Enter Equipment Budget"/>

            <!-- Utilities -->
            <Label text="Utilities"/>

            <TextField fx:id="utilitiesTextField"
                       prefWidth="250.0"
                       promptText="Enter Utilities Budget"/>

            <!-- Salary -->
            <Label text="Salary"/>

            <TextField fx:id="salaryTextField"
                       prefWidth="250.0"
                       promptText="Enter Salary Budget"/>

            <!-- Transport -->
            <Label text="Transport"/>

            <TextField fx:id="transportTextField"
                       prefWidth="250.0"
                       promptText="Enter Transport Budget"/>

            <!-- Marketing -->
            <Label text="Marketing"/>

            <TextField fx:id="marketingTextField"
                       prefWidth="250.0"
                       promptText="Enter Marketing Budget"/>

        </VBox>

        <!-- Buttons -->
        <HBox layoutX="40.0"
              layoutY="600.0"
              spacing="15.0">

            <Button text="Save Budget"
                    prefWidth="110.0"
                    onAction="#onSaveButtonClick"/>

            <Button text="Clear"
                    prefWidth="90.0"
                    onAction="#onClearButtonClick"/>

            <Button text="Back"
                    prefWidth="90.0"
                    onAction="#onBackButtonClick"/>

        </HBox>

        <!-- Budget Table -->
        <TableView fx:id="budgetTableView"
                   layoutX="360.0"
                   layoutY="70.0"
                   prefHeight="600.0"
                   prefWidth="710.0">

            <columns>

                <TableColumn fx:id="monthColumn"
                             text="Month"
                             prefWidth="90.0"/>

                <TableColumn fx:id="rawMaterialsColumn"
                             text="Raw"
                             prefWidth="90.0"/>

                <TableColumn fx:id="equipmentColumn"
                             text="Equip"
                             prefWidth="90.0"/>

                <TableColumn fx:id="utilitiesColumn"
                             text="Utilities"
                             prefWidth="90.0"/>

                <TableColumn fx:id="salaryColumn"
                             text="Salary"
                             prefWidth="90.0"/>

                <TableColumn fx:id="transportColumn"
                             text="Transport"
                             prefWidth="90.0"/>

                <TableColumn fx:id="marketingColumn"
                             text="Marketing"
                             prefWidth="90.0"/>

                <TableColumn fx:id="totalColumn"
                             text="Total"
                             prefWidth="90.0"/>

            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

        </TableView>

    </children>

</AnchorPane>