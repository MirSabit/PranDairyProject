<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0"
            prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.prandairyproject.Accountant.SupplierPaymentsController">

    <children>

        <!-- Title -->
        <Label layoutX="410.0"
               layoutY="20.0"
               text="Supplier Payments">
            <font>
                <Font size="26.0"/>
            </font>
        </Label>

        <!-- Left Form -->
        <VBox layoutX="30.0"
              layoutY="70.0"
              prefWidth="300.0"
              spacing="12.0">

            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>

            <!-- Supplier ID -->
            <Label text="Supplier ID"/>
            <TextField fx:id="supplierIdTextField"
                       prefWidth="250.0"
                       promptText="Enter Supplier ID"/>

            <!-- Supplier Name -->
            <Label text="Supplier Name"/>
            <TextField fx:id="supplierNameTextField"
                       prefWidth="250.0"
                       promptText="Enter Supplier Name"/>

            <!-- Purchase Order -->
            <Label text="Purchase Order"/>
            <TextField fx:id="purchaseOrderTextField"
                       prefWidth="250.0"
                       promptText="Enter Purchase Order No."/>

            <!-- Amount -->
            <Label text="Amount"/>
            <TextField fx:id="amountTextField"
                       prefWidth="250.0"
                       promptText="Enter Amount"/>

            <!-- Payment Method -->
            <Label text="Payment Method"/>
            <ComboBox fx:id="paymentMethodComboBox"
                      prefWidth="250.0"
                      promptText="Select Payment Method"/>

            <!-- Payment Date -->
            <Label text="Payment Date"/>
            <DatePicker fx:id="paymentDatePicker"
                        prefWidth="250.0"/>

            <!-- Buttons -->
            <HBox spacing="10">

                <Button text="Record Payment"
                        prefWidth="130.0"
                        onAction="#onRecordPaymentButtonClick"/>

                <Button text="Clear"
                        prefWidth="80.0"
                        onAction="#onClearButtonClick"/>

                <Button text="Back"
                        prefWidth="80.0"
                        onAction="#onBackButtonClick"/>

            </HBox>

        </VBox>

        <!-- Table -->
        <TableView fx:id="supplierPaymentTableView"
                   layoutX="350.0"
                   layoutY="70.0"
                   prefHeight="600.0"
                   prefWidth="720.0">

            <columns>

                <TableColumn fx:id="paymentIdColumn"
                             text="Payment ID"
                             prefWidth="100.0"/>

                <TableColumn fx:id="supplierIdColumn"
                             text="Supplier ID"
                             prefWidth="100.0"/>

                <TableColumn fx:id="supplierNameColumn"
                             text="Supplier Name"
                             prefWidth="140.0"/>

                <TableColumn fx:id="purchaseOrderColumn"
                             text="Purchase Order"
                             prefWidth="120.0"/>

                <TableColumn fx:id="amountColumn"
                             text="Amount"
                             prefWidth="90.0"/>

                <TableColumn fx:id="paymentMethodColumn"
                             text="Payment Method"
                             prefWidth="120.0"/>

                <TableColumn fx:id="paymentDateColumn"
                             text="Payment Date"
                             prefWidth="110.0"/>

            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

        </TableView>

    </children>

</AnchorPane>