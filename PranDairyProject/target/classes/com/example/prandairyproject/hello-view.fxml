<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0"
            prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.prandairyproject.HelloController">

    <children>

        <!-- Background -->
        <Pane prefHeight="720.0"
              prefWidth="1100.0"
              style="-fx-background-color: linear-gradient(to bottom,#E8F5E9,#BBDEFB);" />

        <!-- Login Card -->
        <VBox alignment="CENTER"
              spacing="15"
              layoutX="325"
              layoutY="40"
              prefWidth="450"
              prefHeight="640"
              style="-fx-background-color:white;
                     -fx-background-radius:20;
                     -fx-border-radius:20;
                     -fx-border-color:#D0D0D0;
                     -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.25),15,0,0,4);">

            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>

            <!-- Logo -->
            <ImageView fx:id="logoImageView"
                       fitHeight="100"
                       fitWidth="100"
                       preserveRatio="true"/>

            <Label text="PRAN Dairy Management System">
                <font>
                    <Font size="24"/>
                </font>
            </Label>

            <Label text="Login to Continue">
                <font>
                    <Font size="15"/>
                </font>
            </Label>

            <Separator prefWidth="330"/>

            <!-- Role -->

            <Label text="Role"
                   maxWidth="320"
                   alignment="CENTER_LEFT"/>

            <ComboBox fx:id="roleComboBox"
                      prefWidth="320"
                      prefHeight="40"
                      promptText="Select Role"/>

            <!-- User ID -->

            <Label text="User ID"
                   maxWidth="320"
                   alignment="CENTER_LEFT"/>

            <TextField fx:id="userIdTextField"
                       promptText="Enter 4 or 7 digit User ID"
                       prefWidth="320"
                       prefHeight="40"/>

            <!-- Password -->

            <Label text="Password"
                   maxWidth="320"
                   alignment="CENTER_LEFT"/>

            <PasswordField fx:id="passwordField"
                           promptText="Enter Password"
                           prefWidth="320"
                           prefHeight="40"/>

            <TextField fx:id="visiblePasswordField"
                       visible="false"
                       managed="false"
                       prefWidth="320"
                       prefHeight="40"/>

            <HBox alignment="CENTER_LEFT"
                  spacing="20"
                  prefWidth="320">

                <CheckBox fx:id="showPasswordCheckBox"
                          text="Show Password"
                          onAction="#onShowPasswordClick"/>

                <CheckBox fx:id="rememberMeCheckBox"
                          text="Remember Me"/>

            </HBox>

            <Hyperlink fx:id="forgotPasswordLink"
                       text="Forgot Password?"
                       onAction="#onForgotPasswordClick"/>

            <HBox alignment="CENTER"
                  spacing="15">

                <Button fx:id="loginButton"
                        text="Login"
                        prefWidth="120"
                        prefHeight="40"
                        onAction="#onLoginButtonClick"/>

                <Button fx:id="clearButton"
                        text="Clear"
                        prefWidth="120"
                        prefHeight="40"
                        onAction="#onClearButtonClick"/>

            </HBox>

            <Button fx:id="exitButton"
                    text="Exit"
                    prefWidth="255"
                    prefHeight="40"
                    onAction="#onExitButtonClick"/>

            <Separator prefWidth="330"/>

            <Label fx:id="statusLabel"
                   text=""
                   wrapText="true"/>

            <Label fx:id="dateTimeLabel"/>

            <Label text="Version 1.0"/>

        </VBox>

    </children>

</AnchorPane>