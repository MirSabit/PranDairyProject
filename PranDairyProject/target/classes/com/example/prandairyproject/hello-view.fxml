<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="420.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.prandairyproject.HelloController">

    <Label layoutX="170" layoutY="30" text="PRAN Dairy Management System">
        <font>
            <Font size="26"/>
        </font>
    </Label>

    <Label layoutX="90" layoutY="110" text="Username"/>

    <TextField fx:id="usernameTextField"
               layoutX="200"
               layoutY="105"
               prefWidth="220"/>

    <Label layoutX="90" layoutY="165" text="Password"/>

    <PasswordField fx:id="passwordField"
                   layoutX="200"
                   layoutY="160"
                   prefWidth="220"/>

    <Label layoutX="90" layoutY="220" text="Role"/>

    <ComboBox fx:id="roleComboBox"
              layoutX="200"
              layoutY="215"
              prefWidth="220"/>

    <Button layoutX="250"
            layoutY="300"
            prefWidth="100"
            text="Login"
            onAction="#onLoginButtonClick"/>

</AnchorPane>