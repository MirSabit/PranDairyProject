<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="610.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.prandairyproject.Marketing_Officer.PromotionalOfferController">
   <children>
      <Label layoutX="183.0" layoutY="14.0" text="Promotional Offers">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <Label layoutX="38.0" layoutY="64.0" prefHeight="17.0" prefWidth="67.0" text="Offer Name" />
      <TextField fx:id="offerNameTextField" layoutX="109.0" layoutY="60.0" />
      <Label layoutX="38.0" layoutY="107.0" prefHeight="17.0" prefWidth="67.0" text="Discount" />
      <TextField fx:id="discountTextField" layoutX="105.0" layoutY="103.0" />
      <Label layoutX="38.0" layoutY="150.0" prefHeight="17.0" prefWidth="67.0" text="Offer Type" />
      <Label layoutX="38.0" layoutY="206.0" prefHeight="17.0" prefWidth="67.0" text="Offer Status" />
      <ComboBox fx:id="offerTypeComboBox" layoutX="105.0" layoutY="146.0" prefWidth="150.0" />
      <ComboBox fx:id="statusComboBox" layoutX="105.0" layoutY="202.0" prefWidth="150.0" />
      <Label layoutX="38.0" layoutY="259.0" prefHeight="17.0" prefWidth="67.0" text="Start Date" />
      <Label layoutX="38.0" layoutY="321.0" prefHeight="17.0" prefWidth="67.0" text="End Date" />
      <DatePicker fx:id="startDatePicker" layoutX="97.0" layoutY="255.0" />
      <DatePicker fx:id="endDatePicker" layoutX="93.0" layoutY="317.0" />
      <Button fx:id="saveButton" layoutX="300.0" layoutY="309.0" mnemonicParsing="false" onAction="#onSaveButtonClick" text="Save" />
      <Button fx:id="clearButton" layoutX="384.0" layoutY="309.0" mnemonicParsing="false" onAction="#onClearButtonClick" text="Clear" />
      <Button fx:id="backButton" layoutX="477.0" layoutY="309.0" mnemonicParsing="false" onAction="#onBackButtonClick" text="Back" />
      <TableView fx:id="offerTableView" layoutX="116.0" layoutY="363.0" prefHeight="200.0" prefWidth="382.0">
        <columns>
          <TableColumn fx:id="offerIdColumn" prefWidth="75.0" text="Offer ID" />
          <TableColumn fx:id="offerNameColumn" prefWidth="75.0" text="Offer Name" />
            <TableColumn fx:id="offerTypeColumn" prefWidth="75.0" text="Offer Type" />
            <TableColumn fx:id="discountColumn" prefWidth="75.0" text="Discount" />
            <TableColumn fx:id="statusColumn" prefWidth="75.0" text="Status" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
