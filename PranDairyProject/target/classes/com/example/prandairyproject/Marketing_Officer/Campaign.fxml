<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.prandairyproject.Marketing_Officer.CampaignController"        prefHeight="589.0"
        prefWidth="600.0">

    <children>

        <Label layoutX="172.0" layoutY="14.0" text="Campaign Management">
            <font>
                <Font size="24.0"/>
            </font>
        </Label>

        <Label layoutX="29.0" layoutY="63.0" text="Campaign Name"/>
        <TextField fx:id="campaignNameTextField"
                   layoutX="125.0"
                   layoutY="59.0"/>

        <Label layoutX="29.0" layoutY="109.0" text="Campaign Type"/>
        <ComboBox fx:id="campaignTypeComboBox"
                  layoutX="125.0"
                  layoutY="105.0"
                  prefWidth="150.0"/>

        <Label layoutX="38.0" layoutY="162.0" text="Target Group"/>
        <ComboBox fx:id="targetGroupComboBox"
                  layoutX="125.0"
                  layoutY="158.0"
                  prefWidth="150.0"/>

        <Label layoutX="58.0" layoutY="211.0" text="Start Date"/>
        <DatePicker fx:id="startDatePicker"
                    layoutX="122.0"
                    layoutY="207.0"
                    prefWidth="156.0"/>

        <Label layoutX="60.0" layoutY="260.0" text="End Date"/>
        <DatePicker fx:id="endDatePicker"
                    layoutX="122.0"
                    layoutY="256.0"
                    prefWidth="156.0"/>

        <Label layoutX="60.0" layoutY="294.0" text="Budget"/>
        <TextField fx:id="budgetTextField"
                   layoutX="125.0"
                   layoutY="290.0"/>

        <Label layoutX="315.0" layoutY="141.0" text="Description"/>
        <TextArea fx:id="descriptionTextArea"
                  layoutX="385.0"
                  layoutY="49.0"
                  prefHeight="200.0"
                  prefWidth="200.0"/>

        <Button fx:id="saveButton"
                layoutX="59.0"
                layoutY="339.0"
                prefWidth="89.0"
                text="Save"
                onAction="#onSaveButtonClick"/>

        <Button fx:id="clearButton"
                layoutX="234.0"
                layoutY="339.0"
                prefWidth="89.0"
                text="Clear"
                onAction="#onClearButtonClick"/>

        <Button fx:id="backButton"
                layoutX="428.0"
                layoutY="339.0"
                prefWidth="89.0"
                text="Back"
                onAction="#onBackButtonClick"/>

        <TableView fx:id="campaignTableView"
                   layoutX="18.0"
                   layoutY="375.0"
                   prefHeight="200.0"
                   prefWidth="557.0">

            <columns>

                <TableColumn fx:id="campaignIdColumn"
                             prefWidth="107.0"
                             text="Campaign ID"/>

                <TableColumn fx:id="campaignNameColumn"
                             prefWidth="80.0"
                             text="Name"/>

                <TableColumn fx:id="campaignTypeColumn"
                             prefWidth="90.0"
                             text="Type"/>

                <TableColumn fx:id="targetGroupColumn"
                             prefWidth="110.0"
                             text="Target Group"/>

                <TableColumn fx:id="budgetColumn"
                             prefWidth="80.0"
                             text="Budget"/>

                <TableColumn fx:id="statusColumn"
                             prefWidth="90.0"
                             text="Status"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>